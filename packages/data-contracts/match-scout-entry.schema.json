{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datademolisher/contracts/match-scout-entry.schema.json",
  "type": "object",
  "required": ["eventKey", "matchKey", "teamNumber", "scoutName"],
  "properties": {
    "eventKey": { "type": "string" },
    "matchKey": { "type": "string" },
    "teamNumber": { "type": "integer" },
    "scoutName": { "type": "string" },
    "autoActions": { "type": "object" },
    "teleopActions": { "type": "object" },
    "endgameResult": { "type": ["string", "null"] },
    "defenseEffectiveness": { "type": ["integer", "null"], "minimum": 0, "maximum": 5 },
    "driverRating": { "type": ["integer", "null"], "minimum": 0, "maximum": 5 },
    "rawNotes": { "type": ["string", "null"] }
  }
}
